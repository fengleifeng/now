// =============================================================================
// effects.json — 状态效果（持续类 Buff/疾病/外伤等），由 EffectSystem 按回合处理
// -----------------------------------------------------------------------------
// Id / Name / Description    标识与 UI 文案
// Type                       Disease 疾病；Buff 增益；Injury 外伤；Instant 瞬间
// IsVisible                  是否显示在 UI（缺省为 true）
// PerTurnEffects             每回合触发，字符串格式 "属性:值"，如 Health:-5、HungerRate:*1.5
//                             支持 +N、-N、*N（乘在速率类上）
// OnApplyEffects             获得效果当刻立即结算，格式同上
// OnRemoveEffects             移除时触发，格式同上
// DefaultDuration             持续回合数；-1 常表示持续至条件消失
// CuredByTag / CuredByCard   可被带某标签或某 Id 的卡治愈/解除
// TriggerCondition            逻辑用触发条件标识（与代码事件对应）
// =============================================================================
[
  {
    "Id": "injury",
    "Name": "受伤",
    "Description": "伤口疼痛，影响行动效率",
    "Type": "Injury",
    "PerTurnEffects": ["Health:-2"],
    "DefaultDuration": 5,
    "CuredByTag": "Medicine",
    "TriggerCondition": "combat_damage"
  },
  {
    "Id": "infection",
    "Name": "伤口感染",
    "Description": "伤口感染了，持续恶化",
    "Type": "Disease",
    "PerTurnEffects": ["Health:-5", "Hunger:-3"],
    "DefaultDuration": 8,
    "CuredByTag": "Medicine",
    "TriggerCondition": "untreated_injury"
  },
  {
    "Id": "food_poisoning",
    "Name": "食物中毒",
    "Description": "吃坏了肚子，上吐下泻",
    "Type": "Disease",
    "OnApplyEffects": ["Health:-15"],
    "PerTurnEffects": ["Health:-3", "HungerRate:*1.5"],
    "DefaultDuration": 4,
    "CuredByTag": "Medicine",
    "TriggerCondition": "eat_raw_meat"
  },
  {
    "Id": "cold",
    "Name": "感冒",
    "Description": "着凉了，浑身发冷",
    "Type": "Disease",
    "PerTurnEffects": ["Energy:-5", "HungerRate:*1.3"],
    "DefaultDuration": 5,
    "CuredByTag": "Medicine",
    "TriggerCondition": "low_temperature"
  },
  {
    "Id": "parasite",
    "Name": "寄生虫",
    "Description": "肚子里有寄生虫，营养都被吸走了",
    "Type": "Disease",
    "PerTurnEffects": ["HungerRate:*2", "Immunity:-5"],
    "DefaultDuration": 10,
    "CuredByTag": "Medicine",
    "TriggerCondition": "eat_raw_fish"
  },
  {
    "Id": "snake_venom",
    "Name": "蛇毒",
    "Description": "被毒蛇咬伤，毒素在蔓延",
    "Type": "Disease",
    "OnApplyEffects": ["Health:-20"],
    "PerTurnEffects": ["Health:-8"],
    "DefaultDuration": 3,
    "CuredByTag": "Medicine",
    "TriggerCondition": "snake_bite"
  },
  {
    "Id": "warmth",
    "Name": "温暖",
    "Description": "火堆旁的温暖让你舒适",
    "Type": "Buff",
    "PerTurnEffects": ["Sanity:+3", "Health:+1"],
    "DefaultDuration": 3,
    "TriggerCondition": "near_fire"
  },
  {
    "Id": "well_fed",
    "Name": "饱足",
    "Description": "吃饱喝足，精力充沛",
    "Type": "Buff",
    "PerTurnEffects": ["Energy:+3", "Immunity:+2"],
    "DefaultDuration": 3,
    "TriggerCondition": "high_hunger_recovery"
  },
  {
    "Id": "sheltered",
    "Name": "庇护",
    "Description": "在屋内感到安全",
    "Type": "Buff",
    "PerTurnEffects": ["Sanity:+5", "HungerRate:*0.8"],
    "DefaultDuration": -1,
    "TriggerCondition": "in_house"
  }
]
